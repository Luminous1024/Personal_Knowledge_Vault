filters:
  and:
    - file.hasTag("考研英语")
views:
  - type: table
    name: 表格
    filters:
      and:
        - 考试科目 == "英语（一）"
    order:
      - file.name
      - 创建时间
      - 考试科目
      - 课程
      - 阶段
      - 老师
      - 开始日期
      - 结束日期
    sort:
      - property: file.ctime
        direction: ASC
